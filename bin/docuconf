#!/usr/bin/env php
<?php

declare(strict_types=1);

// docuconf command line: export a declaration as contract.cue, or check the
// environment against it. A declaration file is a PHP file that returns a
// Docuconf\Declaration (see README).

// Composer 2.2+ tells bin proxies where the autoloader is, which also covers
// path repositories, where this file is symlinked rather than copied into vendor/.
$candidates = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
if (isset($GLOBALS['_composer_autoload_path'])) {
    array_unshift($candidates, $GLOBALS['_composer_autoload_path']);
}
$found = null;
foreach ($candidates as $autoload) {
    if (is_file($autoload)) {
        $found = $autoload;
        break;
    }
}
if ($found === null) {
    fwrite(STDERR, "docuconf: cannot find the Composer autoloader (vendor/autoload.php); run composer install\n");
    exit(1);
}
require $found;

exit(Docuconf\Cli::main($argv, STDOUT, STDERR));
