parameters:
    level: 8
    paths:
        - src
        - tests
    # tests/ExampleWebhooksTest.php calls the examples' App\Webhooks, and
    # tests/ExampleShopTest.php the shop example's App\Shop.
    scanFiles:
        - examples/orders/app/Webhooks.php
        - examples/shop/app/Shop.php
    excludePaths:
        - tests/Fixtures/laravel-app/*
    treatPhpDocTypesAsCertain: false
