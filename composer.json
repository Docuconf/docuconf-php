{
    "name": "docuconf/docuconf",
    "description": "Typed configuration contracts for PHP apps: declare env vars and files on top of vlucas/phpdotenv, validate them at boot, export a CUE contract for the platform.",
    "type": "library",
    "license": "MIT",
    "keywords": ["configuration", "environment", "dotenv", "env", "contract", "cue", "kubernetes", "laravel", "symfony", "validation"],
    "homepage": "https://docuconf.dev/languages/laravel/",
    "support": {
        "issues": "https://github.com/docuconf/docuconf-php/issues",
        "source": "https://github.com/docuconf/docuconf-php"
    },
    "authors": [
        {"name": "The docuconf authors"}
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "opis/json-schema": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "devium/toml": "^1.1",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "ext-openssl": "To check TLS, CA bundle and PKCS#12 keystore file inputs",
        "symfony/yaml": "To read YAML config files",
        "devium/toml": "To read TOML config files (^1.1)"
    },
    "autoload": {
        "psr-4": {
            "Docuconf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docuconf\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/docuconf"],
    "extra": {
        "laravel": {
            "providers": ["Docuconf\\Laravel\\DocuconfServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
