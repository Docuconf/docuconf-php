{
    "name": "docuconf/example-orders",
    "description": "The orders example service: Laravel with docuconf.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "docuconf/docuconf": "@dev",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "repositories": [
        {"type": "path", "url": "../..", "options": {"symlink": true}}
    ],
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
