{
    "name": "docuconf/example-orders-symfony",
    "description": "The orders example service: Symfony with docuconf.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "docuconf/docuconf": "@dev",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "repositories": [
        {"type": "path", "url": "../..", "options": {"symlink": true}}
    ],
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
